{
  "expo": {
    "name": "SafePay AI",
    "slug": "safepay-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/safapaylogo.png",
    "scheme": "safepay",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.safepay.ai"
    },
    "android": {
      "package": "com.safepay.ai",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/safapaylogo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/safapaylogo.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "SafePay needs access to your photos so you can set a profile picture.",
          "cameraPermission": "SafePay needs camera access so you can take a profile selfie."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1220",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0B1220"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SafePay uses your location to detect transactions made from unusual places and protect you from fraud."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SafePay uses Face ID to let you sign in securely and approve payments."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
